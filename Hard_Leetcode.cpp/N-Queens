#include <bits/stdc++.h>
// #include "lib/debug.cpp"
using namespace std;
// https://leetcode.com/problems/n-queens/description/
vector<vector<string>> ans;
bool Check(int n, int hang, int i, vector<string> &tmp)
{
    // Phần tử ở hàng > 0 và cột = 0
    if (hang > 0 && i == 0)
    {
        int len = hang - 1;
        while (len >= 0)
        {
            if (tmp[len][i] == 'Q')
            {
                return false;
            }
            len--;
        }
        int len2 = hang - 1;
        int right = i + 1;
        while (len2 >= 0 && right < n)
        {
            if (tmp[len2][right] == 'Q')
            {
                return false;
            }
            len2--;
            right++;
        }
        return true;
    }
    // Phần tử ở hàng > 0 và 0 < i < n - 1
    else if (hang > 0 && i > 0 && i < n - 1)
    {
        int len = hang - 1;
        while (len >= 0)
        {
            if (tmp[len][i] == 'Q')
            {
                return false;
            }
            len--;
        }
        int len2 = hang - 1;
        int right2 = i + 1;
        while (len2 >= 0 && right2 < n)
        {
            if (tmp[len2][right2] == 'Q')
            {
                return false;
            }
            len2--;
            right2++;
        }
        int len3 = hang - 1;
        int left3 = i - 1;
        while (len3 >= 0 && left3 >= 0)
        {
            if (tmp[len3][left3] == 'Q')
            {
                return false;
            }
            len3--;
            left3--;
        }
        return true;
    }
    // Phần tử hàng > 0 và cột = n - 1
    else
    {
        int len = hang - 1;
        while (len >= 0)
        {
            if (tmp[len][i] == 'Q')
            {
                return false;
            }
            len--;
        }
        int len3 = hang - 1;
        int left3 = i - 1;
        while (len3 >= 0 && left3 >= 0)
        {
            if (tmp[len3][left3] == 'Q')
            {
                return false;
            }
            len3--;
            left3--;
        }
        return true;
    }
    // Phần tử ở hàng = 0 luôn đ
    return true;
}

void Try(int n, int hang, vector<string> &tmp)
{
    if (hang == n)
    {
        ans.push_back(tmp);
        return;
    }
    for (int i = 0; i < n; i++)
    {
        if (Check(n, hang, i, tmp))
        {
            tmp[hang][i] = 'Q';
            Try(n, hang + 1, tmp);
            tmp[hang][i] = '.';
        }
    }
    return;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int n;
    cin >> n;
    vector<string> tmp(n, string(n, '.'));
    Try(n, 0, tmp);
    for (int k = 0; k < ans.size(); k++)
    {

        for (int r = 0; r < ans[k].size(); r++)
        {
            cout << ans[k][r] << "\n ";
        }
        cout << "\n";
    }
    return 0;
}